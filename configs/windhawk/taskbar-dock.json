{
  "mods": {
    "windows-11-taskbar-styler": {
      "theme": "DockLike",
      "controlStyles[0].target": "Taskbar.TaskbarFrame#TaskbarFrame",
      "controlStyles[0].styles[0]": "CornerRadius=12",
      "controlStyles[0].styles[1]": "Margin=0,0,0,6",
      "controlStyles[0].styles[2]": "Background:=#CC11111B",
      "controlStyles[0].styles[3]": "BorderBrush:=#22FFFFFF",
      "controlStyles[0].styles[4]": "BorderThickness=1",
      "controlStyles[1].target": "Taskbar.TaskbarBackground#BackgroundControl",
      "controlStyles[1].styles[0]": "CornerRadius=12",
      "controlStyles[1].styles[1]": "Background:=#CC11111B"
    },
    "windows-11-start-menu-styler": {
      "theme": "TranslucentStartMenu",
      "disableNewStartMenuLayout": true
    },
    "windows-11-notification-center-styler": {
      "theme": "Translucent"
    }
  }
}
